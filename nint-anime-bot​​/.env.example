# ទទួលបានពី @BotFather ក្នុង Telegram (វាយ /newbot)
BOT_TOKEN=your_telegram_bot_token_here

# ដូចគ្នាទៅនឹង App Nint Anime (Supabase Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# ប្រើ SERVICE ROLE KEY (មិនមែន anon key ទេ) ព្រោះ bot ត្រូវអាន/សរសេរដោយមិនកំណត់ដោយ RLS user session
# ព្រមានៈ កុំដាក់ key នេះក្នុង client-side code ណាមួយ ត្រូវប្រើតែក្នុង server bot នេះប៉ុណ្ណោះ
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Deep link ត្រឡប់ទៅ App ពេលអ្នកប្រើត្រូវការទិញ VIP (ឧ. https://nintanime.app ឬ custom scheme)
APP_SUBSCRIBE_URL=https://your-app-url.com/subscribe

# លីង Homepage របស់ App (សម្រាប់ប៊ូតុង "🌐 បើក Web App" ក្នុង /start) — បើទុកទទេ ប្រើ APP_SUBSCRIBE_URL ជំនួស
APP_URL=https://your-app-url.com

# រូបភាព Banner សម្រាប់សារ /start (ស្រេចចិត្ត — ទុកទទេបើមិនចង់ប្រើ)
START_BANNER_URL=

# ===== ការផុសរឿងថ្មីទៅ Channel ស្វ័យប្រវត្តិ (ស្រេចចិត្ត) =====
# សំខាន់៖ ការផុសនេះមានតែ Poster/Trailer + ព័ត៌មានសង្ខេបរបស់ "រឿង" (show) ប៉ុណ្ណោះ
# Bot មិនផុសព័ត៌មានវគ្គ (episode) ឬលីងចាក់វីដេអូទៅ Channel ជាដាច់ខាត — ដើម្បីរក្សា VIP paywall
# username របស់ Bot ដោយគ្មាន @ (ឧ. Nint_AnimeVIP_bot)
BOT_USERNAME=Nint_AnimeVIP_bot
# Channel ID ឬ Username (ឧ. @NintAnime) — Bot ត្រូវត្រូវបានបន្ថែមជា Admin ក្នុង Channel នេះសិន
CHANNEL_ID=@your_channel_username
# ចន្លោះពេលពិនិត្យរឿងថ្មី (គិតជានាទី)
POST_INTERVAL_MINUTES=5

# ===== ការផុសផ្សព្វផ្សាយ (Promo) ស្វ័យប្រវត្តិ (ស្រេចចិត្ត) =====
# Group/Channel ដែលចង់ post ការផ្សព្វផ្សាយ App (បើទុកទទេ ប្រើ CHANNEL_ID ដដែល)
# សម្រាប់ Group ធម្មតា (មិនមែន Channel) ត្រូវប្រើលេខ Chat ID ដែលចាប់ផ្តើមដោយ -100...
PROMO_TARGET_ID=
# ចន្លោះពេលផុសផ្សព្វផ្សាយ (គិតជាម៉ោង)
PROMO_INTERVAL_HOURS=6
# លេខ Telegram ID របស់ admin ដែលអាចប្រើ /promo និង /announce ដើម្បីផុសភ្លាមៗ (ញែកដោយសញ្ញា , បើមានច្រើននាក់)
ADMIN_TELEGRAM_IDS=
